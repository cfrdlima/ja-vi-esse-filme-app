<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Nada do app vai para backup nem para outro aparelho: o token
     do Firebase Auth fica em sharedpref e o cache do Firestore em database
     (decisão 010). As listas voltam pelo login, do Firestore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
