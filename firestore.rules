rules_version = '2';

// Nega tudo por padrão (decisão 010). Só o que tiver match explícito abre,
// e só o dono acessa users/{uid}/…. Testes em firestore/test (decisão 012).
service cloud.firestore {
  match /databases/{database}/documents {

    // Só o Google está ligado no Auth (decisão 010). Exigir o provedor aqui
    // impede que ligar outro (anônimo, e-mail) abra escrita a qualquer um.
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Id do TMDB: inteiro positivo, sem zero à esquerda, com até 10 dígitos.
    function isTmdbId(id) {
      return id.matches('^[1-9][0-9]{0,9}$');
    }

    // Caminho de imagem do TMDB, como "/pB8BM7pdSp6B6Ih7QZ4DrQ3PmJK.jpg".
    // Só o caminho, nunca uma URL: o host vem do app (TmdbImageUrl).
    function isTmdbImagePath(path) {
      return path is string && path.matches('^/[A-Za-z0-9_-]{1,64}[.](jpg|png)$');
    }

    // Nota de meia em meia estrela: 1 = 0,5 estrela, 10 = 5 (decisão 018).
    function isRating(rating) {
      return rating is int && rating >= 1 && rating <= 10;
    }

    // Dia em que assistiu, escolhido pelo usuário, sem hora nem fuso
    // (decisão 018). Aqui só o formato e os intervalos: o dia fora do
    // calendário (30 de fevereiro) e o futuro ficam no domínio, porque as
    // regras não sabem qual é "hoje" no fuso de quem assistiu.
    function isWatchedOn(day) {
      return day is string
        && day.matches('^(18(8[89]|9[0-9])|19[0-9]{2}|[2-9][0-9]{3})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    // Id automático do Firestore (doc()), como a lista nasce no app
    // (decisão 019).
    function isListId(id) {
      return id is string && id.matches('^[A-Za-z0-9]{20}$');
    }

    // Nome da lista: de 1 a 50 caracteres, não só espaços e sem caractere de
    // controle (quebra de linha, tab). O domínio tira os espaços das pontas.
    function isListName(name) {
      return name is string
        && name.size() >= 1
        && name.size() <= 50
        && name.trim().size() >= 1
        && !name.matches('(?s).*\\p{Cc}.*');
    }

    // Listas do filme: mapa de listId para a hora em que entrou (decisão
    // 019). As regras não leem cada chave, então a junção com vírgulas tem
    // de ter o tamanho exato de n ids de 20 caracteres: uma chave com
    // vírgula dentro não se passa por duas.
    function isListsMap(lists) {
      let joined = lists.keys().join(',');
      return lists is map
        && lists.size() >= 1
        && lists.size() <= 50
        && joined.size() == lists.size() * 21 - 1
        && joined.matches('^[A-Za-z0-9]{20}(,[A-Za-z0-9]{20})*$');
    }

    // Formato das decisões 013, 018 e 019. Chaves fixas e tipos fechados limitam o
    // tamanho do documento, a única barreira contra abuso da cota do Spark
    // até o App Check (decisão 010). Sem nenhuma marca e fora de qualquer
    // lista, o documento é apagado, e não gravado.
    function isValidMovie(movie) {
      let marks = ['watchedAt', 'watchlistAt', 'favoriteAt'];
      return movie.keys().hasOnly(marks.concat(['title', 'posterPath', 'cachedAt', 'rating', 'watchedOn', 'lists']))
        && movie.keys().hasAll(['title', 'cachedAt'])
        && (movie.keys().hasAny(marks) || 'lists' in movie)
        && movie.title is string
        && movie.title.trim().size() >= 1
        && movie.title.size() <= 300
        && (!('posterPath' in movie) || isTmdbImagePath(movie.posterPath))
        && movie.cachedAt is timestamp
        && (!('watchedAt' in movie) || movie.watchedAt is timestamp)
        && (!('watchlistAt' in movie) || movie.watchlistAt is timestamp)
        && (!('favoriteAt' in movie) || movie.favoriteAt is timestamp)
        && (!('rating' in movie) || ('watchedAt' in movie && isRating(movie.rating)))
        && (!('watchedOn' in movie) || ('watchedAt' in movie && isWatchedOn(movie.watchedOn)))
        && (!('lists' in movie) || isListsMap(movie.lists));
    }

    // As datas são do servidor (decisão 013): o cliente não escolhe quando
    // marcou nem quando copiou do TMDB. Uma data só entra como request.time
    // ou fica igual à salva. Na criação, resource é null.
    function isServerTimeOrKept(field) {
      let movie = request.resource.data;
      return !(field in movie)
        || movie[field] == request.time
        || (resource != null
          && field in resource.data
          && movie[field] == resource.data[field]);
    }

    // Mudar a cópia do TMDB renova o cachedAt, que conta o prazo de 6 meses
    // dos termos do TMDB (§1.C).
    function isCopyRenewedOrKept() {
      let movie = request.resource.data;
      return movie.cachedAt == request.time
        || (resource != null
          && movie.cachedAt == resource.data.cachedAt
          && movie.title == resource.data.title
          && movie.get('posterPath', null) == resource.data.get('posterPath', null));
    }

    // Uma lista por escrita, a hora da que entra é request.time e a das
    // que já estavam não muda (decisão 019). A hora nova não pode repetir
    // uma antiga: a diferença dos valores tem de ser exatamente request.time.
    function isListsChangeServerTime() {
      let after = request.resource.data.get('lists', {});
      let before = resource == null ? {} : resource.data.get('lists', {});
      let diff = after.diff(before);
      return diff.affectedKeys().size() <= 1
        && diff.changedKeys().size() == 0
        && (diff.addedKeys().size() == 0
          || after.values().toSet().difference(before.values().toSet()) == [request.time].toSet());
    }

    function hasServerTimes() {
      return isServerTimeOrKept('watchedAt')
        && isServerTimeOrKept('watchlistAt')
        && isServerTimeOrKept('favoriteAt')
        && isCopyRenewedOrKept()
        && isListsChangeServerTime();
    }

    match /users/{uid}/movies/{movieId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && isTmdbId(movieId)
        && isValidMovie(request.resource.data)
        && hasServerTimes();
    }

    match /users/{uid}/lists/{listId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && isListId(listId)
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.keys().hasAll(['name'])
        && isListName(request.resource.data.name);
    }
  }
}
