rules_version = '2';

// Nega tudo por padrão (decisão 010). Só o que tiver match explícito abre.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/movies/{movieId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && movieId.matches('^[1-9][0-9]{0,9}$')
        && request.resource.data.keys().hasOnly(['watched', 'watchlist', 'favorite'])
        && request.resource.data.keys().hasAll(['watched', 'watchlist', 'favorite'])
        && request.resource.data.watched is bool
        && request.resource.data.watchlist is bool
        && request.resource.data.favorite is bool;
    }
  }
}
